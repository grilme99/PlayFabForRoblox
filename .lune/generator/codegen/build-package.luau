local fs = require("@lune/fs")
local serde = require("@lune/serde")

local Result = require("../vendor/result")
type Result<T, E> = Result.Result<T, E>

local NO_EDIT_HEADER = "This file is automatically generated. Do not edit."

export type ApiInfo = {
	-- Name of the API (e.g. `client` or `multiplayer`).
	name: string,
	title: string,
	version: string,
	description: string,
}

--- Generates the README.md file for the package
local function generateReadme(apiInfo: ApiInfo)
	-- TODO: Fill out README
	return table.concat({
		`<!-- {NO_EDIT_HEADER} -->`,
		``,
		`# {apiInfo.title}`,
		``,
		`> {apiInfo.description}`,
		``,
		`## Installation`,
		``,
		`## Usage`,
		``,
		`## License`,
		``,
	}, "\n")
end

local function generateWally(apiInfo: ApiInfo)
	local toml = serde.encode("toml", {
		package = {
			name = `playfab-roblox/{apiInfo.name}`,
			description = apiInfo.description,
			version = `3.0.{apiInfo.version}`,
			-- TODO: Get license from the API response
			license = "MIT",
			authors = { "Brooke Rhodes <hello@brooke.sh>" },
			registry = "https://github.com/UpliftGames/wally-index",
			realm = "shared",
		},
		dependencies = {
			PlayFabShared = "playfab-roblox/shared@^1.0.0",
		},
	}, true)

	return `# {NO_EDIT_HEADER}\n\n{toml}`
end

local function buildPackage(apiInfo: ApiInfo): Result<nil, string>
	print(`  Building package for {apiInfo.title} (API version {apiInfo.version})`)
	local basePath = `modules/{apiInfo.name}`

	-- Use scopes to avoid variable shadowing
	do
		local success, err = pcall(fs.writeDir, basePath)
		if not success then
			return Result.Err(`Failed to write package directory ({basePath}):\n\t{err}`)
		end
	end

	-- Create the top-level files
	local readme = generateReadme(apiInfo)
	do
		local success, err = pcall(fs.writeFile, `{basePath}/README.md`, readme)
		if not success then
			return Result.Err(`Failed to write README.md file:\n\t{err}`)
		end
	end
	do
		local wally = generateWally(apiInfo)
		local success, err = pcall(fs.writeFile, `{basePath}/wally.toml`, wally)
		if not success then
			return Result.Err(`Failed to write wally.toml file:\n\t{err}`)
		end
	end

	-- Create the source files
	do
		local success, err = pcall(fs.writeDir, `{basePath}/src`)
		if not success then
			return Result.Err(`Failed to write source directory ({basePath}/src):\n\t{err}`)
		end
	end
	do
		local success, err = pcall(fs.writeFile, `{basePath}/src/init.luau`, "")
		if not success then
			return Result.Err(`Failed to write init.luau file:\n\t{err}`)
		end
	end
	do
		local success, err = pcall(fs.writeFile, `{basePath}/src/apis.luau`, "")
		if not success then
			return Result.Err(`Failed to write apis.luau file:\n\t{err}`)
		end
	end
	do
		local success, err = pcall(fs.writeFile, `{basePath}/src/types.luau`, "")
		if not success then
			return Result.Err(`Failed to write types.luau file:\n\t{err}`)
		end
	end

	return Result.Ok(nil)
end

return buildPackage
